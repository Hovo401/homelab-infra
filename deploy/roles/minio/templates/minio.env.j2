MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}
MINIO_VOLUMES="{{ minio_data_dir }}"
MINIO_OPTS="--address 127.0.0.1:{{ minio_port }} --console-address 127.0.0.1:{{ minio_console_port }}"
# Console UI is reverse-proxied at /minio-console/ on {{ minio_domain }};
# tells MinIO to rewrite its asset/redirect paths under that prefix.
MINIO_BROWSER_REDIRECT_URL=https://{{ minio_domain }}/minio-console/
